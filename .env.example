# Copy this file to .env (same folder, ignored by git) and fill in the values.
# The backend reads it from the folder it is started from (back/).
# Secrets have no default anywhere (SEC-10): without the required ones the app does not start.
# Generate random values, e.g.:  openssl rand -base64 36

# ---- Required ---------------------------------------------------------------------------------
# Database password.
DB_PASSWORD=
# Signs the access tokens. At least 32 random characters.
JWT_SECRET=
# Encrypts phone numbers, card holders and second-factor secrets at rest (SEC-09). At least 32
# random characters. To rotate it: set the old one in CIFRADO_CLAVES_ANTERIORES (v1=old), the new
# one here with CIFRADO_VERSION_ACTUAL=v2, and restart.
CIFRADO_CLAVE_ACTUAL=
# CIFRADO_VERSION_ACTUAL=v1
# CIFRADO_CLAVES_ANTERIORES=

# ---- Optional ---------------------------------------------------------------------------------
# Password of the demo accounts (ana.ruiz@demo.plantalibre.local...). Without it new demo
# accounts get a random password.
DEMO_PASSWORD=

# App password of no.reply.planta.libre@gmail.com: the 16 letters, without spaces.
# Without it the backend does not send mail and prints the recovery link in the log.
MAIL_PASSWORD=

# Where operational alerts go (messages in the dead-letter queue).
# ALERTAS_EMAIL=

# Have I Been Pwned check of new passwords (k-anonymity). On by default.
# VERIFICAR_FILTRACIONES_HIBP=true

# ---- Asynchronous charging through RabbitMQ ---------------------------------------------------
# Hardened broker (SEC-07): ./docker/rabbitmq/generar-certificados.sh, then `docker compose up -d`.
MENSAJERIA_HABILITADA=false
# Used by docker-compose.yml to create the broker's admin and the app account.
RABBITMQ_ADMIN_USER=planta-libre-admin
RABBITMQ_ADMIN_PASSWORD=
RABBITMQ_APP_PASSWORD=
# TLS and the app's own account and vhost; never guest.
# RABBITMQ_URL=amqps://planta-libre-api:<RABBITMQ_APP_PASSWORD>@localhost:5671/planta-libre
# The local broker's certificate is signed by the local CA: trust it.
# SPRING_RABBITMQ_SSL_BUNDLE=rabbitmq
# SPRING_SSL_BUNDLE_PEM_RABBITMQ_TRUSTSTORE_CERTIFICATE=file:docker/rabbitmq/certs/ca.pem
# Signs the charge messages (SEC-08). At least 32 random characters.
# MENSAJERIA_FIRMA_SECRETO=
