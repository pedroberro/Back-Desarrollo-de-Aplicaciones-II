# Copy this file to .env (same folder, ignored by git) and fill in the values.
# The backend reads it from the folder it is started from (back/).

# App password of no.reply.planta.libre@gmail.com: the 16 letters, without spaces.
# Without it the backend does not send mail and prints the recovery link in the log.
MAIL_PASSWORD=

# Asynchronous charging of bookings through RabbitMQ. Start the broker with
# `docker compose up -d rabbitmq` (console at http://localhost:15672, guest/guest).
MENSAJERIA_HABILITADA=false
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
