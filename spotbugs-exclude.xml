<?xml version="1.0" encoding="UTF-8"?>
<!-- Findings reviewed by hand and accepted, each with its reason. Anything new still fails the build. -->
<FindBugsFilter>
    <!-- The demo seeder seeds Random per space and day on purpose, so every startup rebuilds the same
         demo bookings; the instance is used several times, the detector only sees one creation per
         loop iteration. Demo data only, never security-relevant. -->
    <Match>
        <Class name="com.daii.backdaii.config.DatosDemoInicializador"/>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
    </Match>
    <!-- Stateless API: the access token travels in the Authorization header, which a cross-site
         request cannot set. The only cookie is the refresh token, sent with SameSite=Strict and only
         to /api/auth (AuthController.cookie), so the browser never attaches it to a cross-site request. -->
    <Match>
        <Class name="com.daii.backdaii.config.SecurityConfig"/>
        <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/>
    </Match>
</FindBugsFilter>
